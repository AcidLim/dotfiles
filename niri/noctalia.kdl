layout {

    focus-ring {
        active-color   "#525a92"
        inactive-color "#fbf8ff"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#525a92"
        inactive-color "#fbf8ff"
        urgent-color   "#ba1a1a"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#525a92"
        inactive-color "#dee0ff"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#525a9280"
    }
}

recent-windows {
    highlight {
        active-color "#525a92"
        urgent-color "#ba1a1a"
    }
}
