// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1784567142644528119 @name=com.danklinux.dms
window-rule {
    match app-id="^com.danklinux.dms$"
    opacity 0.80
    open-floating true
    open-focused true
    min-width 1200
    min-height 800
    background-effect {
        saturation 1
    }
    default-floating-position x=700 y=280
}

// @id=wr_1784567793188108742 @name=thunar
window-rule {
    match app-id="^thunar$"
    opacity 0.80
}

// @id=wr_1784567810532189293 @name=org.gnome.Nautilus
window-rule {
    match app-id="^org.gnome.Nautilus$"
    opacity 0.80
}

// @id=wr_1784567880984479404 @name=code
window-rule {
    match app-id="^code$"
    opacity 0.90
}

// @id=wr_1785850400364990676 @name=QQ
window-rule {
    match app-id="^QQ$" title="^QQ$"
    opacity 0.85
    open-floating true
    min-width 1200
    min-height 800
}

// @id=wr_1785851569212190134 @name=jetbrains-rustrover startup
window-rule {
    match app-id="^jetbrains-rustrover$" title="^(欢迎访问|Welcome to) RustRover$"
    open-floating true
}

// @id=wr_1785852793621584544 @name=jetbrains-studio
window-rule {
    match app-id="^jetbrains-studio$" title="^(欢迎访问|Welcome to) Android Studio$"
    open-floating true
}

// @id=wr_1785853049017886608 @name=com.follow.clash
window-rule {
    match app-id="^com.follow.clash$"
    open-floating true
    min-width 1200
    min-height 800
}

// @id=wr_1785853551266731001 @name=localsend
window-rule {
    match app-id="^localsend$"
    open-floating true
    min-width 1200
    min-height 800
    default-floating-position x=700 y=280
}

window-rule {
    match app-id="^nm-connection-editor$"
    default-window-height { fixed 800; }
    default-column-width { fixed 1500; }
    open-floating true
}
