// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1784567142644528119 @name=com.danklinux.dms
window-rule {
    match app-id="^com.danklinux.dms$"
    opacity 0.80
    open-floating true
    open-focused true
    max-width 1200
    max-height 800
    background-effect {
        saturation 1
    }
    default-floating-position x=700 y=280
}

// @id=wr_1784567793188108742 @name=thunar
window-rule {
    match app-id="^thunar$"
    opacity 0.80
}

// @id=wr_1784567810532189293 @name=org.gnome.Nautilus
window-rule {
    match app-id="^org.gnome.Nautilus$"
    opacity 0.80
}

// @id=wr_1784567880984479404 @name=code
window-rule {
    match app-id="^code$"
    opacity 0.90
}
