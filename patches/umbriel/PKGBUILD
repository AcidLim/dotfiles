# Maintainer: Noctalia Team <team@noctalia.dev>
#
# 这份 PKGBUILD 复制自 AUR `umbriel-git`（对应 pkgver 0.1.0.r1504.e0da106），
# 唯一改动是在 build() 之前加了 prepare()，用来应用同目录的
# 0001-ipc-coalesce-snapshots.patch。
#
# 为什么不直接用 `paru -S umbriel-git`：paru 每次都会把 AUR 的 PKGBUILD
# 重新拉下来，放在这里（以及 AUR 缓存目录里）的改动会被覆盖，prepare() 就丢了。
# 所以补丁版要在本目录用 `makepkg -si` 构建。
#
# 上游 PKGBUILD 有变化时：`paru -Gp umbriel-git > /tmp/PKGBUILD.aur`，
# 与本文件 diff，把新增的 depends/makedepends/build 参数合并进来，保留 prepare()。

pkgname=umbriel-git
pkgver=0.1.0.r1504.e0da106
pkgrel=1
epoch=1
pkgdesc='A Wayland compositor designed for daily use, with scrolling, dwindle, and master layouts, per-output workspaces, window rules, blur, shadows, and fluid animations'
arch=('x86_64' 'aarch64')
url='https://github.com/noctalia-dev/umbriel'
license=('MIT')
depends=(
  'cairo'
  'gcc-libs'
  'glibc'
  'jemalloc'
  'lcms2'
  'libdrm'
  'libdisplay-info'
  'libei>=1.3'
  'libglvnd'
  'libinput'
  'libxcb'
  'libxkbcommon'
  'mesa'
  'pango'
  'pixman'
  'systemd-libs'
  'tomlplusplus'
  'wayland'
  'xcb-util-wm'
  'xorg-xwayland'
  'xdg-desktop-portal-umbriel-git'
  'wlroots0.20>=0.20.1'
)
makedepends=(
  'git'
  'meson'
  'ninja'
  'nlohmann-json'
  'pkgconf'
  'wayland-protocols'
)
provides=('umbriel')
conflicts=('umbriel')
source=('git+https://github.com/noctalia-dev/umbriel.git#branch=main')
b2sums=('SKIP')

# ── 与 AUR 原版唯一的区别 ───────────────────────────────────────────────
prepare() {
  cd "$srcdir/umbriel"
  patch -Np1 -i "$startdir/0001-ipc-coalesce-snapshots.patch"
}

pkgver() {
  cd "$srcdir/umbriel"
  local version
  version=$(tr -d '[:space:]' < VERSION)
  printf '%s.r%s.%s' \
    "$version" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

build() {
  arch-meson "$srcdir/umbriel" "$srcdir/umbriel/build" \
    -Db_ndebug=true \
    -Dtests=disabled \
    -Dharness=disabled
  meson compile -C "$srcdir/umbriel/build"
}

package() {
  DESTDIR="$pkgdir" meson install -C "$srcdir/umbriel/build" --no-rebuild
  install -Dm644 "$srcdir/umbriel/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
