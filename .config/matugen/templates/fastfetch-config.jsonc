{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/logo/logo.png",
    "width": 30,
    "padding": { "top": 0, "left": 1, "right": 3 },
    "color": { "1": "{{colors.primary.default.hex}}" }
  },
  
  "display": {
    "separator": "  │  ",
  "color": {
    "keys": "{{colors.primary.default.hex}}",
    "title": "{{colors.primary.default.hex}}",
    "output": "{{colors.on_surface.default.hex}}",
    "separator": "{{colors.secondary.default.hex}}"
  },
    "key": {
      "type": "string",
      "width": 16
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name} ~"
    },
    {
      "type": "os",
      "key": "  System  ",
      "keyColor": "{{colors.secondary.default.hex}}",
    },
    {
      "type": "kernel",
      "key": "󰌽  Kernel  ",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "cpu",
      "key": "󰍛  CPU     ",
      "keyColor": "{{colors.secondary.default.hex}}",
      "format": "{name} @ {freq-max}"
    },
    {
      "type": "command",
      "key": "󰓅  Topology",
      "keyColor": "{{colors.secondary.default.hex}}",
      "text": "echo $(lscpu -p=Core,Socket | grep -v '^#' | sort -u | wc -l) cores , $(nproc --all) threads"    
    },

    {
      "type": "gpu",
      "key": "󰢮  GPU     ",
      "format": "{1} {2}",
      "keyColor": "{{colors.secondary.default.hex}}",
      //"outputColor": "{{colors.secondary_fixed_dim.default.hex}}"
    },
    {
      "type": "shell",
      "key": "  Shell   ",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "uptime",
      "key": "󰥔  Uptime  ",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "wm",
      "key": "󰖯  Desktop ",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "memory",
      "key": "  Memory  ",
      "keyColor": "{{colors.secondary.default.hex}}",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "󰋊  Storage ",
      "keyColor": "{{colors.secondary.default.hex}}",
      "folders": ["/"]
    },
    {
      "type": "colors",
      "key": "󰏘  Colors  ",
      "keyColor": "{{colors.secondary.default.hex}}",
      "symbol": "circle",
      "block": { "width": 1, "range": [0, 7] }
    }
  ]
}
